import { Settings } from "settings.slint";

export global ColorPalette {
    // Tabs at left side
    in-out property <color> tab_selected_color: Settings.dark_theme ? #7db6ff : #2f6fd2;
    in-out property <color> tab_hovered_color: Settings.dark_theme ? #7db6ff26 : #2f6fd218;
    // ListView
    in-out property <color> list_view_item_color: Settings.dark_theme ? #1d2229 : #f7f9fc;
    in-out property <color> list_view_item_hovered_color: Settings.dark_theme ? #26303a : #e9f1fb;
    in-out property <color> list_view_item_selected_color: Settings.dark_theme ? #2f3e4f : #dce9fa;
    in-out property <color> list_view_item_selected_hovered_color: Settings.dark_theme ? #3a4b60 : #cddff7;

    in-out property <color> list_view_header_color: Settings.dark_theme ? #161b22 : #e6edf5;
    in-out property <color> list_view_clicked_header_color: Settings.dark_theme ? #1f2630 : #d7e4f2;
    
    // Popup
    in-out property <color> popup_background: Settings.dark_theme ? #242b34 : #f2f6fb;
    in-out property <color> popup_background_border: Settings.dark_theme ? #303947 : #cad7e5;
    in-out property <color> popup_background_title_line: Settings.dark_theme ? #303947 : #d6e2ef;
    in-out property <color> popup_border_color: Settings.dark_theme ? #3a4655 : #c3d1df;

    in-out property <color> line_item_color: Settings.dark_theme ? #2d3642 : #d6e1ed;

    in-out property <color> remove_item_color_button: Settings.dark_theme ? #2a323d : #e0e8f2;

    in-out property <color> hint_color: Settings.dark_theme ? #98a3b3 : #6f7c8f;

    // Semantic / accent colors
    in-out property <color> accent_color: Settings.dark_theme ? #77b2ff : #2f7be6;
    in-out property <color> accent_hover_color: Settings.dark_theme ? #95c4ff : #1f69d6;
    in-out property <color> success_color: Settings.dark_theme ? #4caf50 : #2e7d32;
    in-out property <color> warning_color: Settings.dark_theme ? #ff9800 : #e65100;
    in-out property <color> error_color: Settings.dark_theme ? #ef5350 : #c62828;
    // Protected-row marker (amber/gold: "kept safe")
    in-out property <color> protected_row_color: Settings.dark_theme ? #e0b000 : #b8860b;

    // Button states
    in-out property <color> button_hover_color: Settings.dark_theme ? #344050 : #dce7f4;
    in-out property <color> button_pressed_color: Settings.dark_theme ? #405166 : #cedded;

    // Focus ring
    in-out property <color> focus_ring_color: Settings.dark_theme ? #77b2ff80 : #2f7be680;
    in-out property <color> compare_left_value_color: Settings.dark_theme ? #6699cc : #224488;
    in-out property <color> compare_right_value_color: Settings.dark_theme ? #cc9966 : #885522;
    in-out property <color> compare_divider_color: Settings.dark_theme ? #444444 : #aaaaaa;
    in-out property <color> compare_info_background: Settings.dark_theme ? #222222 : #d8d8d8;
    in-out property <color> compare_info_border: Settings.dark_theme ? #444444 : #bbbbbb;
    in-out property <color> compare_loading_card_background: Settings.dark_theme ? #2a2a2a : #f4f4f4;
    in-out property <color> compare_main_background: Settings.dark_theme ? #181818 : #ebebeb;
    in-out property <color> compare_title_color: Settings.dark_theme ? #f0f0f0 : #111111;
    in-out property <color> compare_resolution_mismatch_background: #ff880033;
    in-out property <color> compare_diff_background: #000000;
    in-out property <color> compare_image_panel_background: Settings.dark_theme ? #0e0e0e : #e0e0e0;
    in-out property <color> compare_split_divider_color: Settings.dark_theme ? #ffffff80 : #00000080;
    in-out property <color> compare_thumbnail_background: Settings.dark_theme ? #222222 : #d4d4d4;

    in-out property <color> error_text_color: #e74c3c;

    in-out property <color> scrim_background_color: #808080cc;
    in-out property <color> scrim_text_color: #ffffff;

    in-out property <color> feature_ok_color: #22aa22;
    in-out property <color> feature_fail_color: #cc2222;

    public pure function get_listview_color(selected: bool, hovered: bool) -> color {
        if (selected) {
            return hovered ? self.list_view_item_selected_hovered_color : self.list_view_item_selected_color;
        } else {
            return hovered ? self.list_view_item_hovered_color : self.list_view_item_color;
        }
    }
    public pure function get_listview_color_with_header(selected: bool, hovered: bool, header: bool) -> color {
        if (header) {
            return selected ? self.list_view_clicked_header_color : self.list_view_header_color;
        } else {
            return self.get_listview_color(selected, hovered);
        }
    }
}
