import { Button, CheckBox, LineEdit } from "std-widgets.slint";
import { PopupBase } from "../components/popup_base.slint";
import { ColorPalette } from "../globals/color_palette.slint";
import { FolderMirrorState, MirrorFolder } from "../globals/folder_mirror_state.slint";
import { FontSizes } from "../globals/fonts.slint";
import { Translations } from "../globals/translations.slint";

component MirrorPath inherits HorizontalLayout {
    in property <string> label;
    in property <string> folder_path;
    in property <MirrorFolder> folder;
    spacing: 8px;

    Text {
        width: min(140px, parent.width * 0.28);
        text: root.label;
        font-size: FontSizes.normal;
        vertical-alignment: center;
        wrap: TextWrap.word-wrap;
    }
    LineEdit {
        text: root.folder_path;
        read-only: true;
        horizontal-stretch: 1;
    }
    Button {
        text: Translations.folder_mirror_choose_text;
        icon: @image-url("../../icons/krokiet_dir.svg");
        colorize-icon: true;
        enabled: !FolderMirrorState.busy;
        clicked => { FolderMirrorState.choose_folder(root.folder); }
    }
}

export component PopupFolderMirror inherits Rectangle {
    callback show_popup();

    popup_window := PopupBase {
        width: min(680px, root.width - 20px);
        x: round(((root.width - self.width) / 2.0) / 1px) * 1px;
        y: max(0px, round(((root.height - self.height) / 2.0) / 1px) * 1px);
        title_text: Translations.folder_mirror_title_text;
        ok_text: Translations.folder_mirror_preview_text;
        cancel_text: Translations.folder_mirror_close_text;
        enabled_ok_button: !FolderMirrorState.busy
            && FolderMirrorState.target_path != ""
            && FolderMirrorState.reference_path != ""
            && FolderMirrorState.archive_path != "";

        VerticalLayout {
            padding: 10px;
            spacing: 5px;

            MirrorPath {
                label: Translations.folder_mirror_target_text;
                folder_path: FolderMirrorState.target_path;
                folder: MirrorFolder.Target;
            }
            MirrorPath {
                label: Translations.folder_mirror_reference_text;
                folder_path: FolderMirrorState.reference_path;
                folder: MirrorFolder.Reference;
            }
            MirrorPath {
                label: Translations.folder_mirror_archive_text;
                folder_path: FolderMirrorState.archive_path;
                folder: MirrorFolder.Archive;
            }
            CheckBox {
                text: Translations.folder_mirror_hash_matching_text;
                checked <=> FolderMirrorState.hash_matching;
                enabled: !FolderMirrorState.busy;
                toggled => { FolderMirrorState.invalidate_preview(); }
            }
            Text {
                text: Translations.folder_mirror_hint_text;
                color: ColorPalette.hint_color;
                font-size: FontSizes.small;
                wrap: TextWrap.word-wrap;
            }
        }

        ok_clicked => { FolderMirrorState.preview(); }
    }

    show_popup() => { popup_window.show(); }
}
